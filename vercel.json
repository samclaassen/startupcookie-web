{
  "buildCommand": "node scripts/build-markdown.mjs",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/services/content-agents/",
      "destination": "/services/gtm-agents/",
      "statusCode": 301
    },
    {
      "source": "/services/content-agents",
      "destination": "/services/gtm-agents/",
      "statusCode": 301
    },
    {
      "source": "/case-studies/type-com/",
      "destination": "/guides/ai-agents-for-content-agencies/",
      "statusCode": 301
    },
    {
      "source": "/case-studies/type-com",
      "destination": "/guides/ai-agents-for-content-agencies/",
      "statusCode": 301
    },
    {
      "source": "/blog/",
      "destination": "/guides/",
      "statusCode": 301
    },
    {
      "source": "/blog",
      "destination": "/guides/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ]
}
